# Manafe3 per-machine settings. Copy this file to .env.local (git-ignored) and fill in THIS PC's folders.
#   Copy-Item .env.local.example .env.local
# Quote nothing; spaces in paths are fine (the laptop user folder is "C:\Users\Windows 10").

# Client drawings, real-project IFC, vendor PDFs: never in git.
#   office PC ENG04-PC:  D:\Manafe3-projects
#   laptop:              a folder you choose, e.g. C:\Users\Windows 10\Documents\Manafe3-projects
MANAFE3_PROJECTS_DIR=

# The private BIMSteelAuto peb folder (office PC only for now):
#   (a private local folder; the app runs fully without it)
BIMSTEELAUTO_PEB_PATH=

# MySteelApp Studio (laptop only): C:\MyStructureApp
MYSTEELAPP_PATH=

# Ports (defaults shown)
MANAFE3_ENGINE_PORT=8765
MANAFE3_WEB_PORT=8000
